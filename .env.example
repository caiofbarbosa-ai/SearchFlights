# Copie para .env e preencha (o .env NUNCA vai para o repositório)

# Supabase (Project Settings -> API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-anon-or-service-key

# Telegram (BotFather + getUpdates/chat id)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Rota monitorada (defaults abaixo; opcional sobrescrever)
ORIGINS=GRU,CGH,VCP
DESTINATION=BKK
DEPARTURE_DATE=2027-07-28
RETURN_DATE=2027-08-05
ADULTS=2

# Chrome para Smiles/Azul (CDP-attach). Vazio = autodetectar
CHROME_PATH=

# RSS de notícias (separados por vírgula)
RSS_FEEDS=https://www.melhoresdestinos.com.br/feed,https://www.melhorescartoes.com.br/feed,https://passageirodeprimeira.com/feed,https://www.pontospravoar.com/feed

# Palavras-chave do filtro (vírgula, case-insensitive) — notícia entra se
# o título/descrição contiver qualquer uma
PROMO_KEYWORDS=c6

# Backfill: páginas antigas varridas por feed (WordPress ?paged=N)
RSS_BACKFILL_PAGES=12

# Smiles & Money: combo milhas+dinheiro no card do voo mais barato
SMILES_COMBO_ENABLED=true
SMILES_COMBO_MAX_MILES=210000
